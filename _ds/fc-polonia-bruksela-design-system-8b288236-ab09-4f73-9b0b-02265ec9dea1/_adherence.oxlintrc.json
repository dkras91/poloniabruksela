{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "ui_kits/graphic-generator/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Barlow Condensed|Inter))/i]",
        "message": "Font not provided by the design system. Available: Barlow Condensed, Inter."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:red|gold|dark|outline)$/]",
        "message": "<Badge> tone must be one of 'red' | 'gold' | 'dark' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|disabled|onClick|type|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, disabled, onClick, type."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|gold|outline|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'gold' | 'outline' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|onChange|placeholder|maxLength|type|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, value, onChange, placeholder, maxLength, type."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:text|time|date)$/]",
        "message": "<Input> type must be one of 'text' | 'time' | 'date'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SelectOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<SelectOption> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Slider'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|onChange|min|max|step|unit|key|ref|className|style|children)$/]",
        "message": "<Slider> doesn't accept that prop. Declared props: label, value, onChange, min, max, step, unit."
      },
      {
        "selector": "JSXOpeningElement[name.name='ToggleOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<ToggleOption> doesn't accept that prop. Declared props: value, label."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "Badge": {
        "replaces": []
      },
      "Button": {
        "replaces": []
      },
      "Input": {
        "replaces": []
      },
      "SelectOption": {
        "replaces": []
      },
      "Slider": {
        "replaces": []
      },
      "ToggleOption": {
        "replaces": []
      }
    },
    "tokens": [
      "--border-on-dark",
      "--brand-accent",
      "--brand-primary",
      "--color-black-60",
      "--color-black-80",
      "--color-cream",
      "--color-gold",
      "--color-gold-dim",
      "--color-graphite",
      "--color-red",
      "--color-red-dim",
      "--font-body",
      "--font-body-weight",
      "--font-display",
      "--font-display-weight",
      "--link-color",
      "--link-color-hover",
      "--radius-lg",
      "--radius-md",
      "--radius-pill",
      "--radius-sm",
      "--safe-square",
      "--safe-story-edge",
      "--space-1",
      "--space-2",
      "--space-3",
      "--space-4",
      "--space-5",
      "--space-6",
      "--space-7",
      "--space-8",
      "--surface-dark",
      "--surface-light",
      "--text-headline",
      "--text-line",
      "--text-muted-on-dark",
      "--text-on-dark",
      "--text-on-light",
      "--text-subhead",
      "--tracking-caps",
      "--tracking-display"
    ],
    "tokenKinds": {
      "--color-red": "color",
      "--color-gold": "color",
      "--color-graphite": "color",
      "--color-cream": "color",
      "--color-red-dim": "color",
      "--color-gold-dim": "color",
      "--color-black-60": "color",
      "--color-black-80": "color",
      "--brand-primary": "color",
      "--brand-accent": "color",
      "--surface-dark": "color",
      "--surface-light": "color",
      "--text-on-dark": "font",
      "--text-on-light": "font",
      "--text-muted-on-dark": "font",
      "--border-on-dark": "color",
      "--link-color": "color",
      "--link-color-hover": "color",
      "--font-display": "font",
      "--font-display-weight": "font",
      "--font-body": "font",
      "--font-body-weight": "font",
      "--text-headline": "font",
      "--text-subhead": "font",
      "--text-line": "font",
      "--tracking-display": "font",
      "--tracking-caps": "font",
      "--space-1": "spacing",
      "--space-2": "spacing",
      "--space-3": "spacing",
      "--space-4": "spacing",
      "--space-5": "spacing",
      "--space-6": "spacing",
      "--space-7": "spacing",
      "--space-8": "spacing",
      "--radius-sm": "radius",
      "--radius-md": "radius",
      "--radius-lg": "radius",
      "--radius-pill": "radius",
      "--safe-square": "spacing",
      "--safe-story-edge": "spacing"
    },
    "fontFamilies": [
      "Barlow Condensed",
      "Inter"
    ]
  }
}